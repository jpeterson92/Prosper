{
  "name": "prosper-local-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.22.1", "npm": "11.19.1"},
  "scripts": {
    "contracts:write": "node tools/contracts.mjs --write",
    "contracts:check": "node tools/contracts.mjs",
    "contracts:negative": "node tools/contract-negative.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "playwright test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
