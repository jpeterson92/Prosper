# Stable text diffs and hashes on Windows and future developer platforms.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.whl binary
# Fidelity-shaped CSV fixtures deliberately preserve UTF-8 BOM and CRLF bytes.
examples/synthetic/fidelity/*.csv -text whitespace=cr-at-eol
examples/synthetic/fidelity/sources/*.csv -text whitespace=cr-at-eol
examples/synthetic/paper/*.csv -text whitespace=cr-at-eol
